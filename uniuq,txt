{% extends 'reports/base.html' %}
{% load static %}

{% block title %}Adl Portal - Shield of Justice & Protection{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-900 text-gray-200 overflow-hidden relative font-sans">
    <div class="fixed inset-0 z-0 opacity-5">
        <svg class="w-full h-full text-gray-700" viewBox="0 0 400 400" fill="none">
            <defs>
                <pattern id="shield-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
                    <path d="M50 10 L80 40 L50 70 L20 40 Z" stroke="currentColor" stroke-width="0.5" fill="none"/>
                    <circle cx="50" cy="40" r="2" fill="currentColor" opacity="0.3"/>
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#shield-pattern)"/>
        </svg>
    </div>

    <div class="fixed top-6 right-6 z-40">
        <div class="bg-gray-800/80 backdrop-blur-md rounded-full p-3 border border-blue-500/20">
            <div class="relative">
                <svg class="w-6 h-6 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                </svg>
                <div class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-blue-400 rounded-full trust-indicator"></div>
            </div>
        </div>
    </div>

    <nav class="relative z-50 bg-gray-900/70 backdrop-blur-lg border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex justify-between items-center h-20">
                <div class="flex items-center space-x-4">
                    <div class="w-10 h-12 bg-gray-800 border border-gray-700 rounded-t-md rounded-b-2xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                           <path d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2V7a5 5 0 00-5-5zm0 2a3 3 0 013 3v2H7V7a3 3 0 013-3z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-white tracking-wide">
                            JUSTICE SHIELD
                        </h1>
                        <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Your Secure Reporting Portal</p>
                    </div>
                </div>
                <div class="hidden md:flex items-center space-x-2">
                    <a href="{% url 'incidents_heatmap' %}" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-800 rounded-lg transition-colors duration-200 text-sm font-medium">Insights</a>
                    <a href="{% url 'resource_landing' %}" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-800 rounded-lg transition-colors duration-200 text-sm font-medium">Guidance</a>
                    <a href="{% url 'check_status' %}" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-800 rounded-lg transition-colors duration-200 text-sm font-medium">Track Report</a>
                    <div class="w-px h-6 bg-gray-700 mx-3"></div>
                    <a href="{% url 'submit_report' %}" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg transition-colors duration-200 font-semibold text-sm shadow-lg shadow-blue-500/10 hover:shadow-blue-500/20">
                        Submit a Secure Report
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="relative z-10 max-w-7xl mx-auto px-6">
        <div class="pt-24 pb-20 text-center">
            <div class="max-w-4xl mx-auto">
                <h1 class="text-5xl md:text-6xl font-extrabold text-white leading-tight mb-6">
                    A Digital <span class="text-blue-400">Sanctuary</span><br> for Justice
                </h1>
                <p class="text-lg text-gray-400 max-w-2xl mx-auto leading-relaxed mb-10">
                    Your courage to speak is protected here. We provide a secure, confidential platform to report injustice, ensuring your voice is heard without compromising your safety.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a href="{% url 'submit_report' %}" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-bold text-base transition-all duration-200 shadow-xl hover:shadow-2xl hover:scale-105 transform">
                        File a Protected Report
                    </a>
                    <a href="{% url 'incidents_heatmap' %}" class="w-full sm:w-auto border-2 border-gray-600 hover:border-gray-500 text-gray-300 hover:text-white px-8 py-3 rounded-lg font-medium transition-colors duration-200">
                        View Community Insights
                    </a>
                </div>
            </div>
        </div>

        <div class="py-20">
             <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-white">Our Commitment to Your Protection</h2>
                <p class="text-gray-400 mt-2">Built on a foundation of security, anonymity, and trust.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-gray-800/50 backdrop-blur-md rounded-xl p-8 border border-gray-700/80">
                    <div class="w-12 h-12 bg-gray-700 rounded-lg flex items-center justify-center mb-5">
                        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Fortress Security</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Your data is secured with end-to-end, military-grade encryption. Our zero-knowledge architecture means not even we can access your report's contents.
                    </p>
                </div>
                <div class="bg-gray-800/50 backdrop-blur-md rounded-xl p-8 border border-gray-700/80">
                    <div class="w-12 h-12 bg-gray-700 rounded-lg flex items-center justify-center mb-5">
                        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Anonymous Voice</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Report without fear. We never collect personal data like IP addresses or browser information, ensuring your identity remains completely protected.
                    </p>
                </div>
                <div class="bg-gray-800/50 backdrop-blur-md rounded-xl p-8 border border-gray-700/80">
                    <div class="w-12 h-12 bg-gray-700 rounded-lg flex items-center justify-center mb-5">
                         <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Justice Network</h3>
                     <p class="text-gray-400 text-sm leading-relaxed">
                        Your report contributes to a larger dataset that helps identify patterns and provides verifiable evidence to advocacy groups and legal partners.
                    </p>
                </div>
            </div>
        </div>
        
        <div class="py-20">
             <div class="max-w-3xl mx-auto text-center">
                 <p class="text-2xl text-gray-300 italic leading-relaxed">
                     "And whoever saves a life, it is as if he has saved all of mankind."
                 </p>
                 <cite class="text-blue-400 text-sm block font-medium mt-4">— The Holy Quran, 5:32</cite>
             </div>
        </div>

    </main>

    <footer class="relative z-10 border-t border-gray-800 bg-gray-900/80 backdrop-blur-lg">
        <div class="max-w-7xl mx-auto py-12 px-6">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="text-center md:text-left">
                     <h3 class="text-white font-bold text-lg mb-1">Justice Shield</h3>
                     <p class="text-gray-500 text-sm max-w-xs">
                        A secure platform dedicated to protecting voices, empowering justice, and building a safer community for all.
                    </p>
                </div>
                <div class="text-center">
                    <p class="text-gray-600 text-sm">
                        &copy; 2025 Justice Shield Platform. All Rights Reserved.
                    </p>
                </div>
            </div>
        </div>
    </footer>
