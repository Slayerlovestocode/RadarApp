{% extends 'reports/base.html' %}
{% load static %}

{% block title %}Adl Portal - Upholding Justice in Our Ummah{% endblock %}

{% block content %}
<div class="min-h-screen bg-black text-white overflow-hidden relative">
    <!-- Animated Background -->
    <div class="fixed inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-blue-900/20 to-teal-900/20"></div>
        <!-- Floating Islamic Geometric Patterns -->
        <div class="absolute top-20 left-20 w-32 h-32 border-2 border-gold-400/20 rotate-45 animate-spin-slow"></div>
        <div class="absolute top-60 right-32 w-24 h-24 border-2 border-emerald-400/30 rotate-12 animate-pulse"></div>
        <div class="absolute bottom-40 left-1/3 w-40 h-40 border border-blue-400/20 rounded-full animate-ping"></div>
        <div class="absolute top-1/3 right-1/4 w-20 h-20 bg-gradient-to-r from-purple-500/10 to-pink-500/10 rotate-45 animate-bounce"></div>
        <!-- Particle Effects -->
        <div class="stars"></div>
    </div>

    <!-- Navigation -->
    <nav class="relative z-50 bg-black/80 backdrop-blur-xl border-b border-white/10">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex justify-between items-center h-20">
                <div class="flex items-center space-x-4">
                    <!-- Unique Logo with Islamic Star -->
                    <div class="relative">
                        <div class="w-12 h-12 bg-gradient-to-br from-gold-400 to-amber-500 rounded-lg rotate-45 animate-pulse"></div>
                        <div class="absolute inset-0 w-12 h-12 border-2 border-white/30 rounded-lg rotate-12 animate-spin-slow"></div>
                        <div class="absolute inset-3 bg-white rounded-full animate-glow"></div>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold bg-gradient-to-r from-gold-400 to-amber-300 bg-clip-text text-transparent">
                            عدل Portal
                        </h1>
                        <p class="text-xs text-gray-400">Justice & Truth</p>
                    </div>
                </div>
                <div class="hidden md:flex items-center space-x-8">
                    <a href="{% url 'incidents_heatmap' %}" class="nav-link group">
                        <span class="text-gray-300 group-hover:text-gold-400 transition-all duration-300">Insights</span>
                        <div class="h-0.5 bg-gradient-to-r from-gold-400 to-transparent w-0 group-hover:w-full transition-all duration-300"></div>
                    </a>
                    <a href="{% url 'check_status' %}" class="nav-link group">
                        <span class="text-gray-300 group-hover:text-emerald-400 transition-all duration-300">Status</span>
                        <div class="h-0.5 bg-gradient-to-r from-emerald-400 to-transparent w-0 group-hover:w-full transition-all duration-300"></div>
                    </a>
                    <a href="{% url 'resource_landing' %}" class="nav-link group">
                        <span class="text-gray-300 group-hover:text-purple-400 transition-all duration-300">Guidance</span>
                        <div class="h-0.5 bg-gradient-to-r from-purple-400 to-transparent w-0 group-hover:w-full transition-all duration-300"></div>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 max-w-7xl mx-auto px-6 py-20">
        <!-- Hero Section with Floating Elements -->
        <div class="text-center mb-32 relative">
            <!-- Trust Indicator -->
            <div class="inline-block mb-12 relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-emerald-400 via-blue-500 to-purple-600 rounded-full blur opacity-30 group-hover:opacity-50 animate-pulse"></div>
                <div class="relative px-8 py-3 bg-black rounded-full border border-emerald-400/50 flex items-center space-x-3">
                    <div class="w-3 h-3 bg-emerald-400 rounded-full animate-ping"></div>
                    <span class="text-emerald-300 font-medium">Amanah • Confidential • Secure</span>
                </div>
            </div>

            <!-- Main Title with Arabic -->
            <div class="space-y-8 mb-16">
                <h1 class="text-7xl md:text-8xl font-black leading-none">
                    <span class="block bg-gradient-to-r from-white via-gold-300 to-amber-400 bg-clip-text text-transparent animate-gradient">
                        STAND
                    </span>
                    <span class="block text-6xl md:text-7xl bg-gradient-to-r from-gold-400 via-amber-300 to-yellow-400 bg-clip-text text-transparent">
                        FOR عدل
                    </span>
                </h1>
                <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed font-light">
                    <span class="text-gold-300">"يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا قَوَّامِينَ بِالْقِسْطِ"</span><br>
                    "O believers! Stand firm for justice as witnesses for Allah" - Quran 4:135
                </p>
            </div>

            <!-- Interactive Action Spheres -->
            <div class="grid md:grid-cols-3 gap-16 mt-24">
                <!-- Report Sphere -->
                <div class="group relative">
                    <div class="absolute -inset-4 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 rounded-full blur-xl opacity-20 group-hover:opacity-40 animate-pulse"></div>
                    <div class="relative">
                        <div class="w-48 h-48 mx-auto bg-gradient-to-br from-blue-600/20 to-purple-700/20 rounded-full border border-white/10 backdrop-blur-lg flex items-center justify-center group-hover:scale-105 transition-all duration-500 cursor-pointer sphere-hover">
                            <div class="text-center space-y-4">
                                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-blue-400 to-purple-500 rounded-full flex items-center justify-center animate-float">
                                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-bold text-white">Bear Witness</h3>
                                <p class="text-sm text-gray-400">شهادة</p>
                            </div>
                        </div>
                        <a href="{% url 'submit_report' %}" class="absolute inset-0 rounded-full"></a>
                    </div>
                    <div class="mt-8 text-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                        <p class="text-gray-400 text-sm">Fulfill your duty to testify for truth</p>
                    </div>
                </div>

                <!-- Insights Sphere -->
                <div class="group relative">
                    <div class="absolute -inset-4 bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 rounded-full blur-xl opacity-20 group-hover:opacity-40 animate-pulse"></div>
                    <div class="relative">
                        <div class="w-48 h-48 mx-auto bg-gradient-to-br from-emerald-600/20 to-teal-700/20 rounded-full border border-white/10 backdrop-blur-lg flex items-center justify-center group-hover:scale-105 transition-all duration-500 cursor-pointer sphere-hover">
                            <div class="text-center space-y-4">
                                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-emerald-400 to-teal-500 rounded-full flex items-center justify-center animate-float">
                                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m-6 3v10"/>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-bold text-white">Seek Knowledge</h3>
                                <p class="text-sm text-gray-400">علم</p>
                            </div>
                        </div>
                        <a href="{% url 'incidents_heatmap' %}" class="absolute inset-0 rounded-full"></a>
                    </div>
                    <div class="mt-8 text-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                        <p class="text-gray-400 text-sm">Explore patterns with wisdom</p>
                    </div>
                </div>

                <!-- Guidance Sphere -->
                <div class="group relative">
                    <div class="absolute -inset-4 bg-gradient-to-r from-purple-500 via-pink-500 to-rose-500 rounded-full blur-xl opacity-20 group-hover:opacity-40 animate-pulse"></div>
                    <div class="relative">
                        <div class="w-48 h-48 mx-auto bg-gradient-to-br from-purple-600/20 to-pink-700/20 rounded-full border border-white/10 backdrop-blur-lg flex items-center justify-center group-hover:scale-105 transition-all duration-500 cursor-pointer sphere-hover">
                            <div class="text-center space-y-4">
                                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-purple-400 to-pink-500 rounded-full flex items-center justify-center animate-float">
                                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-bold text-white">Islamic Guidance</h3>
                                <p class="text-sm text-gray-400">هداية</p>
                            </div>
                        </div>
                        <a href="{% url 'resource_landing' %}" class="absolute inset-0 rounded-full"></a>
                    </div>
                    <div class="mt-8 text-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                        <p class="text-gray-400 text-sm">Wisdom from Quran & Sunnah</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Check - Floating Card -->
        <div class="fixed bottom-8 right-8 z-50">
            <div class="group relative">
                <div class="absolute -inset-1 bg-gradient-to-r from-gold-400 to-amber-500 rounded-2xl blur opacity-25 group-hover:opacity-50 animate-pulse"></div>
                <div class="relative bg-black/90 backdrop-blur-xl border border-gold-400/30 rounded-2xl p-6 max-w-sm">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-8 h-8 bg-gradient-to-br from-gold-400 to-amber-500 rounded-lg flex items-center justify-center">
                            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <h3 class="text-white font-bold">Follow with Hikmah</h3>
                    </div>
                    <p class="text-gray-400 text-sm mb-4">Check your report status</p>
                    <a href="{% url 'check_status' %}" class="inline-flex items-center text-gold-400 hover:text-gold-300 transition-colors text-sm font-medium">
                        Track Report
                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-white/10 bg-black/50 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto py-12 px-6 text-center">
            <p class="text-gray-500 text-sm">
                © 2025 عدل Portal • "وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا" - Quran 32:24
            </p>
        </div>
    </footer>
</div>

<style>
@keyframes gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

@keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes glow {
    0%, 100% { box-shadow: 0 0 20px rgba(255, 255, 255, 0.1); }
    50% { box-shadow: 0 0 30px rgba(255, 255, 255, 0.3), 0 0 40px rgba(255, 215, 0, 0.1); }
}

.animate-gradient {
    background-size: 300% 300%;
    animation: gradient 4s ease-in-out infinite;
}

.animate-spin-slow {
    animation: spin-slow 20s linear infinite;
}

.animate-float {
    animation: float 3s ease-in-out infinite;
}

.animate-glow {
    animation: glow 2s ease-in-out infinite;
}

.sphere-hover:hover {
    transform: scale(1.05) rotateY(10deg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(255, 255, 255, 0.1);
}

.stars {
    position: absolute;
    width: 100%;
    height: 100%;
    background: radial-gradient(2px 2px at 20% 30%, rgba(255, 255, 255, 0.3), transparent),
                radial-gradient(2px 2px at 40% 70%, rgba(255, 255, 255, 0.2), transparent),
                radial-gradient(1px 1px at 90% 40%, rgba(255, 255, 255, 0.4), transparent),
                radial-gradient(1px 1px at 50% 50%, rgba(255, 255, 255, 0.2), transparent);
    background-repeat: repeat;
    background-size: 400px 400px;
    animation: float 10s ease-in-out infinite;
}

.gold-400 { color: #fbbf24; }
.gold-300 { color: #fcd34d; }
.text-gold-400 { color: #fbbf24; }
.text-gold-300 { color: #fcd34d; }
.bg-gold-400 { background-color: #fbbf24; }
.border-gold-400\/20 { border-color: rgba(251, 191, 36, 0.2); }
.border-gold-400\/30 { border-color: rgba(251, 191, 36, 0.3); }
.border-gold-400\/50 { border-color: rgba(251, 191, 36, 0.5); }
.from-gold-400 { --tw-gradient-from: #fbbf24; }
.to-gold-400 { --tw-gradient-to: #fbbf24; }
</style>
{% endblock %}










